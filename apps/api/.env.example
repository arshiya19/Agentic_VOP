# Agentic_VOP API — environment configuration

# --- New Supabase project (where we WRITE: agent_runs, issues, etc.) ---
AGENTIC_VOP_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
# service_role key from Supabase Dashboard -> Settings -> API -> "service_role secret"
# (the LONGER secret one — bypasses RLS). Keep this OUT of git.
AGENTIC_VOP_SUPABASE_SERVICE_KEY=eyJ...

# --- Anthropic for agent LLM calls ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Tenable / Nessus (required to use the live tenable connector) ---
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# --- NVD API key (OPTIONAL — without it, NVD lookups are slower due to rate limits.
#     Get a free key at https://nvd.nist.gov/developers/request-an-api-key) ---
NVD_API_KEY=
