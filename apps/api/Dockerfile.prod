# Stage 1: Builder — install production dependencies
FROM python:3.11-slim AS builder

WORKDIR /build

# Copy only the dependency manifest first for layer caching
COPY pyproject.toml ./

# Install production dependencies (no dev group) into a clean prefix
RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: Runtime — lean image with only app + packages
FROM python:3.11-slim AS runtime

# Install curl for the HEALTHCHECK instruction
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Create non-root user
RUN useradd --create-home --uid 1000 appuser

WORKDIR /app

# Copy application source
COPY app/ ./app/

# Create logs directory writable by appuser
RUN mkdir -p /app/logs && chown appuser:appuser /app/logs

# Switch to non-root user
USER appuser

EXPOSE 8000

# Health check: verify API is responsive
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/healthz || exit 1

ENTRYPOINT ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
