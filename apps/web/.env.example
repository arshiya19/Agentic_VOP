# Copy this file to .env and fill in real values for local development.
# Never commit .env (it's git-ignored).

# Supabase project — get these from your Supabase dashboard:
# Project Settings → API → Project URL and Project API Keys → anon/publishable
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Backend API gateway (FastAPI). Empty in v1; will be wired once apps/api exists.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Header values the frontend sends on backend calls. v1 just placeholders.
VITE_USER_API_KEY=local-dev-user-key
VITE_ADMIN_API_KEY=local-dev-admin-key

# Set "true" to skip Supabase auth flow in local dev (auto-logs-in as fake admin).
# No effect in production builds. Set to "false" to test the real login flow.
VITE_BYPASS_AUTH=true
